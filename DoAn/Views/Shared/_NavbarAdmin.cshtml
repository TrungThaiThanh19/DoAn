<nav class="navbar navbar-expand bg-light navbar-light sticky-top px-4 py-0">
    
    <div class="navbar-nav align-items-center ms-auto">
        <div class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                <img class="rounded-circle me-lg-2" src="~/img/user.jpg" style="width: 40px; height: 40px;" />
                <span class="d-none d-lg-inline-flex">
                    @{
                        var role = Context.Session.GetString("RoleName");
                        var username = Context.Session.GetString("Username");
                        var staffName = Context.Session.GetString("StaffName");

                        if (role == "nhanvien")
                        {
                            @Html.Raw(string.IsNullOrEmpty(staffName) ? "Nhân viên" : staffName)
                        }
                        else
                        {
                            @Html.Raw(string.IsNullOrEmpty(username) ? "Người dùng" : username)
                        }
                    }
                </span>
            </a>
            <div class="dropdown-menu dropdown-menu-end bg-light border-0 rounded-0 rounded-bottom m-0">
                <a href="#" class="dropdown-item">My Profile</a>
                <a href="#" class="dropdown-item">Settings</a>
                <a asp-action="Logout" asp-controller="TaiKhoan" class="dropdown-item">Log Out</a>
            </div>
        </div>
    </div>
</nav>
