@using Microsoft.AspNetCore.Http
<style>
    .nav-link {
        font-size: 14px !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding: 10px 15px;
    }

    .nav-link-toggle {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .nav-link-toggle::after {
            content: "\f107"; /* FontAwesome ▼ */
            font-family: "Font Awesome 5 Free";
            font-weight: 900;
            font-size: 12px;
        }

    .submenu a {
        padding-left: 30px !important;
        font-size: 13px !important;
    }
</style>

<div class="sidebar pe-4 pb-3 bg-light" style="min-height: 100vh;">
    <nav class="navbar navbar-light flex-column align-items-center">
        <!-- Logo căn giữa -->
        <a href="/Admin/Index" class="navbar-brand mx-4 mb-3 text-center">
            <img src="~/img/z7002361398537_7bd4b0666545b71eb43c49a2bf5e87ce.jpg"
                 alt="Logo" class="img-fluid rounded-circle shadow-sm"
                 style="height: 70px; width: 70px; object-fit: cover;">
        </a>

        <!-- Thông tin user ngay dưới logo -->
        <div class="d-flex flex-column align-items-center text-center mb-4">
            <div class="position-relative mb-2">
                <img class="rounded-circle border border-2 border-white shadow-sm"
                     src="~/img/user.jpg" alt="User"
                     style="width: 60px; height: 60px; object-fit: cover;">
                <!-- trạng thái online -->
                <div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
            </div>
            <div>
                @{
                    var sessionUser = Context.Session.GetString("Username") ?? "Người dùng";
                    var sessionStaff = Context.Session.GetString("StaffName");
                    var sessionRole = Context.Session.GetString("RoleName") ?? "Unknown";

                    // Ưu tiên hiển thị StaffName nếu là nhân viên
                    var displayName = (sessionRole == "nhanvien" && !string.IsNullOrEmpty(sessionStaff))
                    ? sessionStaff
                    : sessionUser;

                    var displayRole = User.IsInRole("admin") ? "admin"
                    : User.IsInRole("nhanvien") ? "nhanvien"
                    : sessionRole;
                }
                <h6 class="mb-0">@displayName</h6>
                <small class="text-muted">@displayRole</small>
            </div>
        </div>

        <!-- Menu -->
        <div class="navbar-nav w-100">
            @if (displayRole == "admin")
            {
                <a href="/ThongKe/Index" class="nav-item nav-link">
                    <i class="fa fa-chart-bar me-2"></i>Thống kê
                </a>
                <a href="/HoaDon/Index" class="nav-item nav-link">
                    <i class="fa fa-shopping-cart me-2"></i>Quản lý hóa đơn
                </a>
                <a href="/LichSuTraHang/Index" class="nav-item nav-link">
                    <i class="fa fa-undo me-2"></i>Quản lý hoàn hàng
                </a>
                <a href="/POS/Index" class="nav-item nav-link">
                    <i class="fa fa-store me-2"></i>Bán hàng tại quầy
                </a>

                <!-- Quản lý tài khoản -->
                <a class="nav-item nav-link nav-link-toggle" data-bs-toggle="collapse" href="#collapseTaiKhoan">
                    <span><i class="fa fa-users me-2"></i> Quản lý tài khoản</span>
                </a>
                <div class="collapse submenu" id="collapseTaiKhoan">
                    <a href="/Staff/Index" class="nav-link">Nhân viên</a>
                    <a href="/KhachHang/Index" class="nav-link">Khách hàng</a>
                </div>

                <!-- Quản lý sản phẩm -->
                <a class="nav-item nav-link nav-link-toggle" data-bs-toggle="collapse" href="#collapseSanPham">
                    <span><i class="fa fa-box me-2"></i> Quản lý sản phẩm</span>
                </a>
                <div class="collapse submenu" id="collapseSanPham">
                    <a href="/Products/Index" class="nav-link">Sản phẩm</a>
                    <a href="/Brands/Index" class="nav-link">Thương hiệu</a>
                    <a href="/Volumes/Index" class="nav-link">Dung tích</a>
                    <a href="/Genders/Index" class="nav-link">Giới tính</a>
                    <a href="/Countries/Index" class="nav-link">Quốc gia</a>
                </div>

                <!-- Quản lý khuyến mãi -->
                <a class="nav-item nav-link nav-link-toggle" data-bs-toggle="collapse" href="#collapseKhuyenMai">
                    <span><i class="fa fa-bullhorn me-2"></i> Khuyến mãi</span>
                </a>
                <div class="collapse submenu" id="collapseKhuyenMai">
                    <a href="/KhuyenMai/Index" class="nav-link">Quản lý khuyến mãi</a>
                    <a href="/Voucher/Index" class="nav-link">Quản lý voucher</a>
                </div>
            }
            else if (displayRole == "nhanvien")
            {
                <a href="/HoaDon/Index" class="nav-item nav-link">
                    <i class="fa fa-shopping-cart me-2"></i>Quản lý hóa đơn
                </a>
                <a href="/POS/Index" class="nav-item nav-link">
                    <i class="fa fa-store me-2"></i>Bán hàng tại quầy
                </a>
            }
        </div>
    </nav>
</div>
