@model DoAn.Models.QuanLyTraHang
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết phiếu hoàn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary mb-0">Chi tiết phiếu hoàn hàng</h2>
    <div>
        <a href="@Url.Action("Index", "LichSuTraHang")" class="btn btn-secondary me-2">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
        <a href="@Url.Action("Details", "HoaDon", new { id = Model.ID_HoaDon })" class="btn btn-info">
            <i class="fas fa-file-invoice"></i> Xem hóa đơn
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Thông tin phiếu hoàn hàng -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Thông tin phiếu hoàn hàng</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Mã phiếu:</strong> @Model.ID_TraHang.ToString()[..8]...</p>
                        <p><strong>Lý do hoàn hàng:</strong> @Model.LyDo</p>
                        <p><strong>Ghi chú:</strong> @(string.IsNullOrEmpty(Model.GhiChu) ? "Không có" : Model.GhiChu)</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Nhân viên xử lý:</strong> @Model.NhanVienXuLy</p>
                        <p><strong>Ngày tạo:</strong> @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
                        <p>
                            <strong>Trạng thái:</strong>
                            @{
                                var statusText = Model.TrangThai switch
                                {
                                    0 => "Yêu cầu hoàn hàng",
                                    1 => "Đã duyệt",
                                    2 => "Đã nhận hàng",
                                    3 => "Đã hoàn tiền",
                                    9 => "Từ chối",
                                    _ => "Không rõ"
                                };
                                var statusClass = Model.TrangThai switch
                                {
                                    0 => "bg-warning",
                                    1 => "bg-info",
                                    2 => "bg-primary",
                                    3 => "bg-success",
                                    9 => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusClass">@statusText</span>
                        </p>
                    </div>
                </div>
                <hr>
                <div class="text-center">
                    <h4 class="text-success">Tổng tiền hoàn: @Model.TongTienHoan.ToString("N0") VND</h4>
                </div>
            </div>
        </div>

        <!-- Chi tiết sản phẩm hoàn -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Chi tiết phiếu hoàn</h5>
            </div>
            <div class="card-body">
                @if (Model.ChiTietTraHangs?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Mã sản phẩm</th>
                                    <th>Sản phẩm</th>
                                    <th>Thể tích</th>
                                    <th>Số lượng</th>
                                    <th>Giá gốc</th>
                                    <th>Tiền hoàn</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int stt = 1;
                                    // --- Tính subtotal của hóa đơn gốc (fallback nếu cần) ---
                                    decimal subtotalInvoice = 0m;
                                    if (Model.HoaDon?.HoaDonChiTiets?.Any() == true)
                                    {
                                        foreach (var hct in Model.HoaDon.HoaDonChiTiets)
                                        {
                                            // ưu tiên DonGia trên chi tiết hóa đơn; nếu bằng 0 thì fallback về SanPhamChiTiet.GiaBan
                                            decimal p = (hct.DonGia > 0m) ? hct.DonGia : (hct.SanPhamChiTiet?.GiaBan ?? 0m);
                                            subtotalInvoice += p * (hct.SoLuong);
                                        }
                                    }

                                    // fallback thêm: nếu subtotal vẫn 0 thì tính từ ChiTietTraHangs (tính unit từ TienHoan/SoLuong hoặc GiaBan)
                                    if (subtotalInvoice == 0m)
                                    {
                                        foreach (var ct in Model.ChiTietTraHangs)
                                        {
                                            decimal unitFromCt = ct.SanPhamChiTiet?.GiaBan ?? (ct.SoLuong > 0 ? Math.Round(ct.TienHoan / ct.SoLuong, 0) : ct.TienHoan);
                                            subtotalInvoice += unitFromCt * ct.SoLuong;
                                        }
                                    }

                                    decimal shipInvoice = Model.HoaDon?.PhuThu ?? 0m;
                                    decimal totalBeforeDiscountInvoice = subtotalInvoice + shipInvoice;

                                    decimal tongTienSauGiamInvoice = Model.HoaDon?.TongTienSauGiam ?? 0m;
                                    if (tongTienSauGiamInvoice == 0m) tongTienSauGiamInvoice = totalBeforeDiscountInvoice;

                                    decimal totalDiscountInvoice = totalBeforeDiscountInvoice - tongTienSauGiamInvoice; // >=0 nếu có giảm

                                    // Tổng gross của các dòng đang hoàn (đã lưu trong TienHoan của từng dòng)
                                    decimal returnedGross = Model.ChiTietTraHangs.Sum(ct => ct.TienHoan);

                                    // Phân bổ giảm giá theo tỷ lệ (an toàn với subtotalInvoice = 0)
                                    decimal discountAllocated = 0m;
                                    if (totalDiscountInvoice > 0m)
                                    {
                                        if (subtotalInvoice > 0m)
                                        {
                                            discountAllocated = decimal.Round(totalDiscountInvoice * (returnedGross / subtotalInvoice), 0, MidpointRounding.AwayFromZero);
                                        }
                                        else
                                        {
                                            // nếu không có subtotal để so sánh, phân bổ toàn bộ theo tỉ lệ = returnedGross/returnedGross => toàn bộ giảm
                                            discountAllocated = decimal.Round(totalDiscountInvoice, 0, MidpointRounding.AwayFromZero);
                                        }
                                    }

                                    // Tổng sau giảm cho phần trả hàng (KHÔNG tính phí ship)
                                    decimal returnedAfterDiscount = returnedGross - discountAllocated;

                                    // So sánh với Model.TongTienHoan (giá trị đã lưu)
                                    decimal computedDiff = returnedAfterDiscount - (Model.TongTienHoan);

                                }

                                @foreach (var item in Model.ChiTietTraHangs)
                                {
                                    // Lấy giá gốc từ chi tiết hóa đơn nếu có, ngược lại fallback
                                    var hoaDonChiTiet = Model.HoaDon?.HoaDonChiTiets?.FirstOrDefault(x => x.ID_SanPhamChiTiet == item.ID_ChiTietSanPham);
                                    decimal unitPrice = 0m;
                                    if (hoaDonChiTiet != null && hoaDonChiTiet.DonGia > 0m)
                                    {
                                        unitPrice = hoaDonChiTiet.DonGia;
                                    }
                                    else
                                    {
                                        unitPrice = item.SanPhamChiTiet?.GiaBan ?? (item.SoLuong > 0 ? Math.Round(item.TienHoan / item.SoLuong, 0) : item.TienHoan);
                                    }

                                    decimal lineOriginalTotal = unitPrice * item.SoLuong; // giá gốc tổng của dòng
                                    decimal lineTienHoan = item.TienHoan; // tiền hoàn dòng (controller lưu)
                                    decimal lineChenhLech = lineOriginalTotal - lineTienHoan;

                                    <tr>
                                        <td>@stt</td>
                                        <td>@(item.SanPhamChiTiet?.SanPham?.Ma_SanPham ?? "Không rõ")</td>
                                        <td>@(item.SanPhamChiTiet?.SanPham?.Ten_SanPham ?? "Không rõ sản phẩm")</td>
                                        <td>
                                            @if (item.SanPhamChiTiet?.TheTich != null)
                                            {
                                                @($"{item.SanPhamChiTiet.TheTich.GiaTri}{item.SanPhamChiTiet.TheTich.DonVi}")
                                            }
                                            else
                                            {
                                                <span class="text-muted">Không rõ</span>
                                            }
                                        </td>
                                        <td>@item.SoLuong</td>
                                        <td class="text-end">@unitPrice.ToString("N0") VND</td>
                                        <td class="text-end text-success">@lineTienHoan.ToString("N0") VND</td>
                                      
                                    </tr>
                                    stt++;
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <td colspan="6" class="text-end"><strong>Tạm tính (trước giảm):</strong></td>
                                    <td class="text-end">@returnedGross.ToString("N0") VND</td>
                                </tr>
                                <tr>
                                    <td colspan="6" class="text-end"><strong>Giảm giá:</strong></td>
                                    <td class="text-end text-danger">
                                        -@discountAllocated.ToString("N0") VND
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="6" class="text-end"><strong>Tổng tiền sản phẩm (sau giảm):</strong></td>
                                    <td class="text-end">@returnedAfterDiscount.ToString("N0") VND</td>
                                </tr>
                                <tr class="table-primary">
                                    <td colspan="6" class="text-end"><strong>Tổng thanh toán hoàn:</strong></td>
                                    <td class="text-end"><strong>@Model.TongTienHoan.ToString("N0") VND</strong></td>
                                </tr>
                            </tfoot>

                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> Không có chi tiết sản phẩm hoàn.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Thông tin hóa đơn gốc -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Thông tin hóa đơn gốc</h5>
            </div>
            <div class="card-body">
                @if (Model.HoaDon != null)
                {
                    <p><strong>Mã hóa đơn:</strong> @Model.HoaDon.Ma_HoaDon</p>
                    <p><strong>Khách hàng:</strong> @(Model.HoaDon.HoTen ?? Model.HoaDon.KhachHang?.Ten_KhachHang ?? "Khách lẻ")</p>
                    <p><strong>Ngày tạo:</strong> @Model.HoaDon.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
                    <p>
                        <strong>Loại hóa đơn:</strong>
                        <span class="badge bg-info">@Model.HoaDon.LoaiHoaDon</span>
                    </p>
                    <p>
                        <strong>Trạng thái:</strong>
                        @{
                            var hoaDonStatusText = Model.HoaDon.TrangThai switch
                            {
                                0 => "Chờ xác nhận",
                                1 => "Đã xác nhận",
                                2 => "Đang vận chuyển",
                                3 => "Đã thanh toán",
                                4 => "Thành công",
                                5 => "Đã hủy",
                                7 => "Hoàn hàng thành công",
                                8 => "Đang xử lý hoàn hàng",
                                _ => "Không rõ"
                            };
                            var hoaDonStatusClass = Model.HoaDon.TrangThai switch
                            {
                                0 => "bg-warning",
                                1 => "bg-info",
                                2 => "bg-primary",
                                3 => "bg-success",
                                4 => "bg-success",
                                5 => "bg-danger",
                                7 => "bg-success",
                                8 => "bg-warning",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @hoaDonStatusClass">@hoaDonStatusText</span>
                    </p>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> Không tìm thấy thông tin hóa đơn.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
